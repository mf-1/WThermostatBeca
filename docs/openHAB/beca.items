// openHAB items for WThermostatBeca (1.38.16+, Home Assistant MQTT discovery)
// Thing ids as discovered: hostname beca-office -> thing becaOffice (homeassistant:device:local:becaOffice)
// Replace 'local' if your MQTT broker thing has another id, and room_* with your location groups.
// Heating control needs the JavaScript Scripting add-on (SCRIPT ECMAScript profile).
// Floor temperature (only with a floor sensor): channel <thing>:floor_temperature

// Office
Group becaOffice "Thermostat - Office" <heating> (room_office) ["Thermostat"]
Number:Temperature becaOffice_Temperature "Temperature" <temperature> (becaOffice) ["Measurement", "Temperature"] { channel="homeassistant:device:local:becaOffice:thermostat#current-temperature", stateDescription=""[pattern="%.1f %unit%"] }
Number:Temperature becaOffice_TargetTemperature "Target temperature" <temperature> (becaOffice) ["Setpoint", "Temperature"] { channel="homeassistant:device:local:becaOffice:thermostat#temperature", stateDescription=""[pattern="%.1f %unit%", min=5, max=35, step=0.5] }
Switch becaOffice_HeatingControl "Heating control" <radiator> (becaOffice) ["Control"] { channel="homeassistant:device:local:becaOffice:thermostat#mode"[profile="transform:JS", toItemScript="|input == 'heat' ? 'ON' : 'OFF'", commandFromItemScript="|input == 'ON' ? 'heat' : 'off'"] }
String becaOffice_OperationMode "Operation mode" <time> (becaOffice) ["Control"] { channel="homeassistant:device:local:becaOffice:thermostat#preset-mode", stateDescription=""[options="auto=Auto,manual=Manual"], commandDescription=""[options="auto=Auto,manual=Manual"] }
String becaOffice_State "State" <fire> (becaOffice) ["Status"] { channel="homeassistant:device:local:becaOffice:thermostat#action", stateDescription=""[readOnly=true, options="heating=Heating,idle=Idle"] }
Number:Temperature becaOffice_ScheduledTemperature "Scheduled temperature (all periods)" <calendar> (becaOffice) ["Setpoint", "Temperature"] { channel="homeassistant:device:local:becaOffice:schedules_temperature", stateDescription=""[pattern="%.1f %unit%", min=5, max=35, step=0.5] }
Switch becaOffice_ChildLock "Child lock" <lock> (becaOffice) ["Switch"] { channel="homeassistant:device:local:becaOffice:locked" }

